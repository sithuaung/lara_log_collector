# Laravel Log Collector Configuration

# Apps (name + log directory).
# If name is empty, it is derived from the directory:
# /home/forge/APP/storage/logs -> APP (handles /current/ symlink too).
apps:
  - name: "app_one"
    log_directory: "/home/forge/app_one/storage/logs"
  - name: "app_two"
    log_directory: "/home/forge/app_two/storage/logs"

# Minimum log level to collect (DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL, ALERT, EMERGENCY)
min_log_level: "ERROR"

# Lark webhook settings
lark:
  webhook_url: "lark-webhook-url"
  batch_size: 100          # Number of log entries to batch before sending
  flush_interval: 5s      # Max time to wait before sending (even if batch not full)
  max_retries: 3          # Number of retry attempts on failure
  retry_delay: 1s         # Initial delay between retries (doubles each retry)

# Buffer settings for backpressure handling
buffer:
  size: 10000             # Maximum entries to buffer
  drop_oldest: false       # When full: true = drop oldest, false = block

# File watcher settings
watcher:
  poll_interval: 2s       # How often to check for new log lines
  state_filename: ""      # Optional; empty = save state in /tmp with a per-log-dir hash

# Suppress unimportant errors and send a daily summary at 5PM Thailand time
suppress:
  patterns:
    - "Token signature mismatch"
    - "some more error"
  match: "substring"      # "substring" (fast) or "regex" (flexible)
  case_insensitive: true
  daily_report_time: "17:00"
  timezone: "Asia/Bangkok"
